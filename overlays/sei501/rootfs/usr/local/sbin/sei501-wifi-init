#!/bin/sh
set -eu
controller=/sys/bus/platform/drivers/meson-gx-mmc
device=ffe03000.mmc

has_wifi() {
    for interface in /sys/class/net/*; do
        [ -d "$interface/wireless" ] || continue
        case "$(readlink -f "$interface/device")" in
            */ffe03000.mmc/*) return 0 ;;
        esac
    done
    return 1
}

wait_wifi() {
    count=0
    while [ "$count" -lt "$1" ]; do
        has_wifi && return 0
        sleep 1
        count=$((count + 1))
    done
    return 1
}

wait_wifi 10 && exit 0
attempt=1
while [ "$attempt" -le 3 ]; do
    echo "SEI501: SDIO Wi-Fi recovery attempt $attempt"
    if [ -L "$controller/$device" ]; then
        printf '%s' "$device" > "$controller/unbind"
        sleep 2
    fi
    printf '%s' "$device" > "$controller/bind"
    wait_wifi 15 && exit 0
    attempt=$((attempt + 1))
done

echo 'SEI501: onboard Wi-Fi did not initialize after 3 recovery attempts' >&2
exit 1
